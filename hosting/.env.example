# Optional Compose overrides. Copy to .env to customize these defaults.
# This is a local image containing owned game files; keep it local.
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.2
TS_HOSTNAME=outlands-t6

# LAN over Tailscale is the default; both server and clients use -lan.
# Optional online mode reads /data/private/plutonium_server_key.
# Provision that file with the hosting helper before selecting online mode.
# Tailscale registration uses its interactive login URL and persistent state.
# Keep authentication keys and account credentials out of this file.
T6_MODE=lan
T6_BIND_IP=0.0.0.0
T6_PORT=4977

# Optional worker features; the AI Compose profile enables both explicitly.
T6_CHAT_ENABLED=0
T6_CAREERS_ENABLED=0
T6_ARMORY_ENABLED=0

# Optional compose.portal.yaml (read-only browser GUI).
# Set the existing server Tailscale IPv4 privately before enabling this overlay.
# PORTAL_TAILSCALE_IP=YOUR_SERVER_TAILSCALE_IPV4
PORTAL_PORT=8085

# Optional compose.accounts.yaml: verified Google login behind a trusted HTTPS
# proxy. Supply the real origin only in private configuration.
# OUTLANDS_ACCOUNT_ORIGIN=https://YOUR_ACCOUNT_HOST
