// Generated by ai/bot_settings.py; original bounded Outlands settings.
preset_name( name )
{
    if ( name == "competitive" ) return "competitive";
    if ( name == "mixed" ) return "mixed";
    if ( name == "relaxed" ) return "relaxed";
    return "mixed";
}

engine( name )
{
    name = preset_name( name );
    if ( name == "competitive" ) return array( 1.0, 450, 800 );
    if ( name == "mixed" ) return array( 0.85, 650, 1000 );
    if ( name == "relaxed" ) return array( 0.7, 800, 1200 );
    return undefined;
}

guard( name )
{
    name = preset_name( name );
    if ( name == "competitive" ) return array( 2000, 4000, 15000, 128 );
    if ( name == "mixed" ) return array( 3000, 6000, 15000, 128 );
    if ( name == "relaxed" ) return array( 4000, 7000, 15000, 128 );
    return undefined;
}

combat( tier, name )
{
    name = preset_name( name );
    if ( name == "competitive" )
    {
        if ( tier == "developing" ) return array( "easy", 2500, 3, 25, 320 );
        if ( tier == "regular" ) return array( "normal", 2000, 4, 20, 260 );
        if ( tier == "experienced" ) return array( "hard", 1700, 4, 17, 230 );
        if ( tier == "standout" ) return array( "hard", 1550, 5, 16, 200 );
    }
    if ( name == "mixed" )
    {
        if ( tier == "developing" ) return array( "easy", 2800, 3, 28, 360 );
        if ( tier == "regular" ) return array( "normal", 2250, 4, 23, 300 );
        if ( tier == "experienced" ) return array( "hard", 1950, 4, 19, 250 );
        if ( tier == "standout" ) return array( "hard", 1750, 5, 17, 220 );
    }
    if ( name == "relaxed" )
    {
        if ( tier == "developing" ) return array( "easy", 3200, 3, 32, 420 );
        if ( tier == "regular" ) return array( "normal", 2500, 4, 26, 340 );
        if ( tier == "experienced" ) return array( "hard", 2200, 4, 22, 300 );
        if ( tier == "standout" ) return array( "hard", 1900, 5, 19, 260 );
    }
    return undefined;
}
